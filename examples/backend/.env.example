# Ajentify org-scoped API key. Never expose this to the browser.
AJENTIFY_ORG_API_KEY=

# The agent the dev backend creates contexts for.
AJENTIFY_AGENT_ID=

# Your org id (required for /generate-api-key).
AJENTIFY_ORG_ID=

# Ajentify REST base URL. Defaults to production.
AJENTIFY_API_URL=https://api.ajentify.com

# Port for this dev backend.
PORT=4000
