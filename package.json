{
  "name": "ajentify-chat-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for @ajentify/chat and its examples",
  "scripts": {
    "build": "pnpm -r --filter @ajentify/chat build",
    "dev": "pnpm -r --parallel --filter @ajentify/chat dev",
    "dev:vite": "pnpm --filter ajentify-chat-example-vite dev",
    "dev:next": "pnpm --filter ajentify-chat-example-next dev",
    "dev:backend": "pnpm --filter ajentify-chat-example-backend dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18"
  }
}
